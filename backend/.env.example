# Adresse de la base PostgreSQL. En local avec Docker Compose :
#   postgresql://cfdc:cfdc@localhost:5432/cfdc
# Sur le serveur de test : l'adresse fournie par Neon.
DATABASE_URL=postgresql://cfdc:cfdc@localhost:5432/cfdc
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Adresse de l'interface : les liens envoyés par email y mènent.
APP_BASE_URL=http://localhost:5173

# Emails. Par défaut, Mailpit en local (docker compose up mailpit) : rien n'est
# vraiment envoyé, tout se lit sur http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_SENDER=CFDC <no-reply@cfdc.local>
