# Nginx sert l'interface et relaie /api vers le backend : l'interface et
# l'API partagent une seule adresse, ce qui garde le cookie de session simple
# (SOLUTION_DESIGN.md, ADR 5). Variables lues au démarrage du conteneur :
#   PORT         port d'écoute (Render le fournit ; 8080 par défaut)
#   BACKEND_URL  adresse du backend (http://backend:8000 dans Docker Compose)
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # Les fichiers construits portent une empreinte dans leur nom : on peut
    # les garder longtemps en cache.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Application à page unique : toute autre adresse renvoie index.html.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
